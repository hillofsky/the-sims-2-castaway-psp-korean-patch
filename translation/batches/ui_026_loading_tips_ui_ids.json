  },
  {
    "id": "TXT_urbzui_01391",
    "source_sha256": "bd9b6abb39811686a3ce6937ab20e015e9670dd7284c04ffef25cc751b7317d6",
    "ko": "대문자"
  },
  {
    "id": "TXT_urbzui_01392",
    "source_sha256": "4e8bbf3a2bea25e35eaea9ebd000f23887bcf6fcf0b344caaa86155e397feab0",
