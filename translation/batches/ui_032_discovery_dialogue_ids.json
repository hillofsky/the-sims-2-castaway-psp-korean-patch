  {
    "id": "TXT_SimsObjects_08490",
    "source_sha256": "b4181a46fc393f1453e1fba685f3e2fbd42f332ddc288efa4f1bb26d68da0127",
    "ko": "$Neighbor을 초대하시겠습니까, 아니면 대화만 하시겠습니까?"
  },
  {
    "id": "TXT_SimsObjects_08492",
